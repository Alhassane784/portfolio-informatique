<!-- CONTACT -->
  <section class="section" id="contact">
    <div class="section-label">// Contact</div>
    <h2 class="section-title">Prenons contact</h2>
    <div class="contact-grid">
      <div class="contact-info">
        <p class="contact-intro">Je suis activement à la recherche d'un emploi en tant que technicien informatique. N'hésitez pas à me contacter!</p>
        <div class="contact-items">
          <div class="contact-item">
            <span class="c-icon">📧</span>
            <div>
              <span class="c-label">Courriel</span>
              <span class="c-value">alhassanef36@gmail.com</span>
            </div>
          </div>
          <div class="contact-item">
            <span class="c-icon">📱</span>
            <div>
              <span class="c-label">Téléphone</span>
              <span class="c-value">+1 (514) 000-0000</span>
            </div>
          </div>
          <div class="contact-item">
            <span class="c-icon">📍</span>
            <div>
              <span class="c-label">Localisation</span>
              <span class="c-value">Montréal, Québec, Canada</span>
            </div>
          
          </div>
        </div>
      </div>

      <form class="contact-form" onsubmit="handleSubmit(event)">
        <div class="form-group">
          <label for="nom">Nom complet</label>
          <input type="text" id="nom" placeholder="Votre nom" required/>
        </div>
        <div class="form-group">
          <label for="email">Courriel</label>
          <input type="email" id="email" placeholder="votre@email.com" required/>
        </div>
        <div class="form-group">
          <label for="sujet">Sujet</label>
          <input type="text" id="sujet" placeholder="Opportunité d'emploi..."/>
        </div>
        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" rows="5" placeholder="Votre message..." required></textarea>
        </div>
        <button type="submit" class="btn-primary full-width">Envoyer le message</button>
        <div class="form-success" id="form-success">✓ Message envoyé avec succès!</div>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <p><span class="bracket">&lt;</span>Alhassane Fofana<span class="bracket">/&gt;</span> · Technicien Informatique · Montréal, QC</p>
    <p class="footer-sub">Disponible immédiatement · Fait avec 💻 et passion</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>
